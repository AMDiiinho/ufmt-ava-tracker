# Copie para ~/.config/ufmt-agent/.env; nunca armazene o arquivo preenchido no vault.
# AVA de Graduação atual (login próprio, sem SSO do Portal/SIGA).
AVA_LOGIN_URL=https://avagraduacao.ufmt.br/login/index.php
AVA_ACTIVITIES_URL=https://avagraduacao.ufmt.br/my/
# Normalmente não é necessário alterar: o agente reconhece CPF/usuário e senha.
# Use estes campos somente se o Portal mudar os nomes dos inputs.
AVA_USERNAME_FIELD=username
AVA_PASSWORD_FIELD=password
AVA_USERNAME=SEU_RGA
AVA_PASSWORD=SUA_SENHA
AVA_TIMEZONE=America/Cuiaba
UFMT_CALENDAR_NAME=UFMT
# Alertas do Google Agenda, em minutos antes do prazo: 15, 7, 3 e 1 dia.
UFMT_REMINDER_MINUTES=21600,10080,4320,1440
